{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrgd.org/schemas/rgd-modules/0.1.0/index",
  "title": "OpenRGD Candidate Module Index",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registry_schema_version": {
      "const": "0.1.0-candidate"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^modules/[a-z0-9.\\-]+/[0-9]+\\.[0-9]+\\.[0-9]+\\.json$"
          }
        },
        "required": [
          "id",
          "version",
          "path"
        ]
      }
    }
  },
  "required": [
    "registry_schema_version",
    "modules"
  ]
}
