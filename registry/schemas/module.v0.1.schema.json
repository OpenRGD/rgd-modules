{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrgd.org/schemas/rgd-modules/0.1.0/module",
  "title": "OpenRGD Module Registry Candidate Descriptor v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-candidate"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "candidate"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "non_actuating": {
          "type": "boolean"
        },
        "automatic_motion_on_load": {
          "type": "boolean"
        },
        "active_calibration_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "non_actuating",
        "automatic_motion_on_load",
        "active_calibration_supported"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_url": {
          "type": "string",
          "pattern": "^https://github\\.com/OpenRGD/[a-z0-9-]+\\.git$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "module_manifest": {
          "const": "module.openrgd.json"
        }
      },
      "required": [
        "git_url",
        "commit_sha",
        "module_manifest"
      ]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pinned_git_cargo"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux-x86_64",
              "linux-aarch64"
            ]
          }
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "binary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      },
      "required": [
        "kind",
        "hosts",
        "package",
        "binary"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": {
          "const": "command_line_json"
        },
        "read_only_command": {
          "const": "inspect"
        },
        "argument_contract": {
          "type": "string",
          "minLength": 1
        },
        "report_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "interface",
        "read_only_command",
        "argument_contract",
        "report_contract"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "publisher",
    "category",
    "summary",
    "maturity",
    "capabilities",
    "permissions_required",
    "safety",
    "source",
    "distribution",
    "integration"
  ]
}
